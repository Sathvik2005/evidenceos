# These endpoint URLs are public client configuration.
VITE_MOMEN_GRAPHQL_URL=https://villa.momen.app/zero/z7Bx4APAzxO/api/graphql-v2
VITE_MOMEN_SUBSCRIPTION_URL=wss://villa.momen.app/zero/z7Bx4APAzxO/api/graphql-subscription

# Server-side only. Never prefix this with VITE_ or put it in browser code.
MOMEN_ADMIN_TOKEN=

# --- Server-side only (Vercel project settings / .env.local). Never prefix with VITE_. ---
APPLICATION_ENV=development
# PostgreSQL connection string (required by the API and by `npm run db:migrate`).
DATABASE_URL=
# Language model for the agents.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Web retrieval for the Research Agent.
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional: a read-only public demo investigation (set both, from `npm run demo:seed`).
DEMO_INVESTIGATION_ID=
DEMO_OWNER_ID=
