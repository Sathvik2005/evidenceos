{
  "name": "evidenceos",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=@evidenceos/frontend",
    "harness": "node scripts/run-harness.mjs",
    "lint": "npm run lint:ui && npm run lint:backend",
    "lint:ui": "npm run lint --workspace=@evidenceos/frontend",
    "lint:backend": "node scripts/py.mjs -m ruff check .",
    "typecheck": "npm run typecheck:ui && npm run typecheck:backend",
    "typecheck:ui": "npm run typecheck --workspace=@evidenceos/frontend",
    "typecheck:backend": "node scripts/py.mjs -m mypy evidenceos",
    "test": "npm run test:backend && npm run test:ui",
    "test:ui": "npm run test --workspace=@evidenceos/frontend",
    "test:e2e": "npm run test:e2e --workspace=@evidenceos/frontend",
    "test:backend": "node scripts/py.mjs -m pytest",
    "backend:setup": "node scripts/setup-backend.mjs",
    "momen:check": "node --env-file=.env.local scripts/check-momen.mjs",
    "db:migrate": "node scripts/py.mjs -m evidenceos.cli.migrate",
    "demo:seed": "node --env-file=.env.local scripts/py.mjs -m evidenceos.cli.demo seed",
    "demo:advance": "node --env-file=.env.local scripts/py.mjs -m evidenceos.cli.demo advance",
    "dev:api": "node scripts/py.mjs -m evidenceos.cli.devserver",
    "seed:advance": "node scripts/seed-advance.mjs",
    "seed": "node --env-file=.env.local scripts/py.mjs -m evidenceos.cli.seed",
    "vercel:env": "node scripts/vercel-env.mjs"
  },
  "description": "Evidence operating system: turns a question into claims, sourced evidence, contradictions and a claim state whose changes are recorded.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sathvik2005/evidenceos.git"
  }
}
