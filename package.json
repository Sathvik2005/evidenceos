{
  "name": "evidenceos",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=@evidenceos/frontend",
    "harness": "node scripts/run-harness.mjs",
    "lint": "npm run lint --workspace=@evidenceos/frontend",
    "test": "npm run test --workspace=@evidenceos/frontend",
    "typecheck": "npm run typecheck --workspace=@evidenceos/frontend",
    "momen:check": "node --env-file=.env.local scripts/check-momen.mjs",
    "test:contracts": "npm run test:contracts --workspace=@evidenceos/frontend",
    "test:golden": "npm run test:golden --workspace=@evidenceos/frontend",
    "test:e2e": "npm run test:e2e --workspace=@evidenceos/frontend",
    "db:migrate": "node scripts/migrate.mjs",
    "demo:seed": "tsx --env-file=.env.local scripts/demo.mts seed",
    "demo:advance": "tsx --env-file=.env.local scripts/demo.mts advance",
    "dev:api": "tsx scripts/dev-server.mts",
    "seed:advance": "node scripts/seed-advance.mjs",
    "seed": "tsx --env-file=.env.local scripts/seed.mts",
    "vercel:env": "node scripts/vercel-env.mjs"
  },
  "description": "Evidence operating system: turns a question into claims, sourced evidence, contradictions and a claim state whose changes are recorded.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sathvik2005/evidenceos.git"
  }
}
